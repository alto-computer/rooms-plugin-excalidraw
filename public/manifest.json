{
  "id": "excalidraw",
  "name": "Excalidraw notes",
  "version": "0.2.0",
  "minAppVersion": "0.5.0",
  "description": "Sketch next to any document, or let an agent draw there. Notes stay with the document, and export as PNG.",
  "permissions": [
    "clipboard",
    "downloads"
  ],
  "slots": {
    "artifact.sidePanel": {
      "title": "Notes"
    }
  },
  "tools": {
    "draw": {
      "description": "Draw on the doc's Excalidraw notes. You can't see the result: keep it simple. Call several times, 3-8 ops each, sending only what is new; nodes before their edges. Give nodes short stable ids ('api','db'); edges join ids. Same id again = update; delete removes ids; clear erases this tool's drawing. Omit x/y: layout is automatic. Labels 1-3 words. Color = meaning: blue input, green output, orange external, purple processing, red error, yellow decision, teal storage. Frames group a zone.",
      "input": {
        "type": "object",
        "required": [
          "doc",
          "ops"
        ],
        "additionalProperties": false,
        "properties": {
          "doc": {
            "type": "string",
            "description": "The Rooms doc: its fileKey or absolute path."
          },
          "direction": {
            "enum": [
              "TB",
              "LR"
            ],
            "description": "Flow for auto layout: top-to-bottom (default) or left-to-right."
          },
          "ops": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "oneOf": [
                {
                  "title": "node",
                  "type": "object",
                  "required": [
                    "op",
                    "id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "node"
                    },
                    "id": {
                      "type": "string",
                      "description": "Short stable id, e.g. 'api'. Re-using an id updates that node."
                    },
                    "shape": {
                      "enum": [
                        "rectangle",
                        "ellipse",
                        "diamond",
                        "text"
                      ],
                      "default": "rectangle",
                      "description": "diamond for decisions, ellipse for start/end, rectangle otherwise."
                    },
                    "label": {
                      "type": "string",
                      "description": "1-3 words."
                    },
                    "color": {
                      "enum": [
                        "blue",
                        "green",
                        "orange",
                        "purple",
                        "red",
                        "yellow",
                        "teal",
                        "pink",
                        "gray"
                      ],
                      "description": "Pastel fill with a matching stroke."
                    },
                    "backgroundColor": {
                      "type": "string",
                      "description": "Hex fill, overrides color."
                    },
                    "strokeColor": {
                      "type": "string",
                      "description": "Hex stroke, overrides color."
                    },
                    "strokeStyle": {
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ]
                    },
                    "fontSize": {
                      "type": "number",
                      "minimum": 14
                    },
                    "parent": {
                      "type": "string",
                      "description": "Id of the frame this node sits in."
                    },
                    "near": {
                      "type": "string",
                      "description": "Place next to this node id (when not connected by an edge)."
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  }
                },
                {
                  "title": "edge",
                  "type": "object",
                  "required": [
                    "op",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "edge"
                    },
                    "id": {
                      "type": "string",
                      "description": "Defaults to '<from>-><to>'."
                    },
                    "from": {
                      "type": "string",
                      "description": "Node id."
                    },
                    "to": {
                      "type": "string",
                      "description": "Node id."
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "1-2 words, only when essential."
                    },
                    "kind": {
                      "enum": [
                        "arrow",
                        "line",
                        "dashed"
                      ],
                      "default": "arrow"
                    },
                    "startArrowhead": {
                      "enum": [
                        null,
                        "arrow",
                        "bar",
                        "dot",
                        "triangle"
                      ]
                    },
                    "endArrowhead": {
                      "enum": [
                        null,
                        "arrow",
                        "bar",
                        "dot",
                        "triangle"
                      ]
                    },
                    "color": {
                      "type": "string",
                      "description": "A color name or hex."
                    }
                  }
                },
                {
                  "title": "frame",
                  "type": "object",
                  "required": [
                    "op",
                    "id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "frame"
                    },
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "children": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Node ids inside the frame."
                    }
                  }
                },
                {
                  "title": "delete",
                  "type": "object",
                  "required": [
                    "op",
                    "ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "delete"
                    },
                    "ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  }
                },
                {
                  "title": "clear",
                  "type": "object",
                  "required": [
                    "op"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "op": {
                      "const": "clear"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "appendTo": "notes/{doc}.ops.jsonl"
    }
  }
}
